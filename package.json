{
  "name": "agentcoliseum",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:bots": "node --conditions=react-server --env-file=.env.local --import tsx scripts/keep-games-live.ts",
    "mcp:duel": "node --conditions=react-server --env-file=.env.local --import tsx scripts/mcp-duel.ts",
    "mcp:oauth-smoke": "node --conditions=react-server --env-file=.env.local --import tsx scripts/mcp-oauth-smoke.ts",
    "mcp:prod-e2e": "node --conditions=react-server --env-file=.env.local --import tsx scripts/mcp-prod-e2e.ts",
    "mcp:ws1-e2e": "node --conditions=react-server --env-file=.env.local --import tsx scripts/mcp-ws1-broadcast-e2e.ts",
    "mcp:adversarial": "node --conditions=react-server --env-file=.env.local --import tsx scripts/mcp-auth-adversarial.test.ts",
    "coliseum:ledger": "node --conditions=react-server --env-file=.env.local --import tsx scripts/coliseum-ledger.test.ts",
    "coliseum:game-sweep": "node --conditions=react-server --env-file=.env.local --import tsx scripts/coliseum-game-sweep.test.ts",
    "coliseum:races": "node --conditions=react-server --env-file=.env.local --import tsx scripts/coliseum-races.test.ts",
    "coliseum:profile": "node --conditions=react-server --env-file=.env.local --import tsx scripts/coliseum-profile.test.ts",
    "coliseum:reasoning": "node --conditions=react-server --env-file=.env.local --import tsx scripts/coliseum-reasoning.test.ts",
    "coliseum:tapback": "node --conditions=react-server --env-file=.env.local --import tsx scripts/coliseum-tapback.test.ts",
    "coliseum:all": "pnpm mcp:adversarial && pnpm coliseum:ledger && pnpm coliseum:game-sweep && pnpm coliseum:races && pnpm coliseum:profile && pnpm coliseum:reasoning && pnpm coliseum:tapback",
    "check:prerender-discipline": "tsx scripts/check-prerender-discipline.ts",
    "clean": "rm -rf .next .turbo && echo 'cleaned .next + .turbo (Turbopack dev cache balloons to ~10GB after a week of HMR; safe to nuke, rebuilds on next dev)'",
    "build": "pnpm check:prerender-discipline && npm run build:mcpb && next build",
    "build:mcpb": "cp mcpb/server/coliseum-mcp.mjs public/coliseum-mcp.mjs && npx -y @anthropic-ai/mcpb pack mcpb public/coliseum.mcpb",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "node --env-file=.env.local --import tsx scripts/apply-migrations.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@privy-io/react-auth": "^3.25.0",
    "@privy-io/server-auth": "^1.32.5",
    "@privy-io/wagmi": "^4.0.7",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@supabase/supabase-js": "^2.105.4",
    "@tanstack/react-query": "^5.100.10",
    "@types/three": "^0.184.1",
    "@upstash/redis": "^1.38.0",
    "boardgame.io": "^0.50.2",
    "chess.js": "^1.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "emoji-datasource-apple": "^16.0.0",
    "lucide-react": "^1.14.0",
    "next": "16.2.6",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "seedrandom": "^3.0.5",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "three": "^0.184.0",
    "tw-animate-css": "^1.4.0",
    "viem": "^2.48.11",
    "wagmi": "^2.19.5",
    "x402-fetch": "^1.2.0",
    "x402-next": "^1.2.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "pnpm": {
    "overrides": {
      "viem": "^2.48.11"
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.5",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.41",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/seedrandom": "^3.0.8",
    "@vitest/ui": "^4.1.6",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.6"
  },
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22"
  }
}
