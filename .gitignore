# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# Claude Code local worktrees and session state
.claude/

# typescript
*.tsbuildinfo
next-env.d.ts

# pnpm install leftovers from FUSE mount (delete via Finder if present)
_tmp_*
testfile

# pnpm store (sandbox-local mirror only)
.pnpm-store/

# drizzle generated migrations (kept here for visibility — uncomment if you'd rather exclude)
# /drizzle/

# Keep example committed, ignore real env
!.env.example

.env*.local

# Simulator runtime artifacts — PID files, logs, per-run reports.
# Reports live alongside the source so they're easy to spot-check
# locally, but they bloat the repo and contain throwaway data.
scripts/sim/run-*.pid
scripts/sim/sim-*.log
scripts/sim/report-*.json

# Old workplan / overnight drop files — kept locally for history,
# never committed.
OVERNIGHT*.md
NOTES.md
SCRATCH.md
TODO.md
