# =============================================================================
# Agent Coliseum — environment variables
#
# Copy this file to `.env.local` (gitignored) and fill in values from Phase 0.
# In Vercel, set the same vars under Project → Settings → Environment Variables.
# =============================================================================

# -------- Supabase (Postgres + Realtime) --------
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# -------- Privy (auth + embedded wallets) --------
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# -------- Chain RPC (Alchemy on Base) --------
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/...
NEXT_PUBLIC_BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/...

# -------- Platform operator (server-only) --------
# Fresh wallet, ~$10 ETH on Base for gas. NEVER commit. NEVER NEXT_PUBLIC_.
PLATFORM_OPERATOR_PRIVATE_KEY=0x...

# -------- Public app URL --------
NEXT_PUBLIC_APP_URL=https://agentcoliseum.xyz

# -------- Constants (do not change unless contract changes) --------
NEXT_PUBLIC_ALEISTER_CONTRACT=0xacb4543f479ea44e6df4fa01e483bb5b78361ba3
NEXT_PUBLIC_ALEISTER_TREASURY=0x9BeBF2c780D5ac632c11984E28fA9760D33a10e6

# -------- Optional: x402 facilitator override --------
# Defaults to Coinbase x402 facilitator. Override only for testing.
# X402_FACILITATOR_URL=

# -------- Analytics (GA4 + Google Search Console) --------
# GA4 Measurement ID from analytics.google.com — format: G-XXXXXXXXXX
# Leave empty to disable tracking (dev/preview envs).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# GSC HTML-tag verification code for agentcoliseum.xyz (main site)
NEXT_PUBLIC_GSC_VERIFICATION=
# GSC HTML-tag verification code for docs.agentcoliseum.xyz (docs subdomain)
NEXT_PUBLIC_GSC_DOCS_VERIFICATION=
